@model lissystem.Models.Form.Planner.OrderScheduler.OrderPriorityRequest

<div id="modalDetail" class="modal-content">
    <div class="modal-header flex-column align-items-start py-2">
        <h5 id="modalTitle" class="modal-title"><i class="bi bi-sort-numeric-up-alt me-2"></i>Order Route Priority update form</h5>
    </div>
    <div class="modal-body px-2 py-0">
        <form id="frmGlobalAction" class="row g-3 mt-2 mb-2">
            <div class="col-auto">
                <label for="numSetAllPriority" class="form-label">Priority</label>
            </div>
            <div class="col-auto">
                <input type="number" id="numSetAllPriority" required value="10" min="1" max="99" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-sm btn-warning" onclick="SetPriorityValueToAll()">Set All</button>
                <button type="button" class="btn btn-sm btn-light" onclick="ResetToAll()">Reset to All</button>
            </div>
        </form>
        <hr />
        <form id="frmOrderPriority" action="" method="post">
            @Html.AntiForgeryToken()
            <table class="table align-middle table-striped">
                <thead>
                    <tr>
                        <th>Order no.</th>
                        <th>Line no.</th>
                        <th>Split no.</th>
                        <th>QTY Request</th>
                        <th>QTY ToGo</th>
                        <th>Priority</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.data.Count(); i++)
                    {
                        <tr>
                            @Html.HiddenFor(p => p.data[i].order_no)
                            @Html.HiddenFor(p => p.data[i].line_no)
                            @Html.HiddenFor(p => p.data[i].split_no)
                            <td>@Model.data[i].order_no</td>
                            <td>@Model.data[i].line_no</td>
                            <td>@Model.data[i].split_no</td>
                            <td>@string.Format("{0:n0}", Model.data[i].qty_reqd)</td>
                            <td>@string.Format("{0:n0}", Model.data[i].qty_togo)</td>
                            <td>
                                @Html.LISTextBoxFor(p => p.data[i].priority, new { @id="numPriority", @type = "number", @class = "form-control form-control-sm", @required = true, @min = 1, @max = 99 })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    </div>
    <div class="modal-footer px-2 py-1">
        <button type="button" class="btn btn-sm btn-success me-2" onclick="SubmitRequest()"><i class="bi bi-save me-1"></i>Update Priority</button>
        <button type="button" class="btn btn-sm btn-secondary" onclick="DismissPopupModal()">Cancel</button>
    </div>
</div>

<script>
    var frmActionValidate = $('#frmGlobalAction').validate();
    var frmValidate = $('#frmOrderPriority').validate();

    function SetPriorityValueToAll() {
        if (frmActionValidate.valid()) {
            let priorityVal = $('input[type=number]#numSetAllPriority').val();
            if (!IsNullOrEmpty(priorityVal)) {
                $('#frmOrderPriority input[type=number]#numPriority').val(priorityVal);
            }
        }
        frmValidate.form();
    }

    function ResetToAll() {
        $('#frmOrderPriority').trigger('reset');
        frmValidate.form();
    }

    function SubmitRequest() {
        if (frmValidate.valid()) {
            ConfirmDialog("Are you sure?", "Confirm to update the Order priority", "warning").then((res) => {
                if (res) {
                    let formData = $('#frmOrderPriority').serialize();
                    $.post('@Url.Action("RequestOrderPriorityUpdate")', formData)
                        .done((data, status, jqXHR) => {
                            if (jqXHR.status === 200) {
                                TableReload();
                                ShowToastSuccess("The Order priority been updated.");
                            }
                            else {
                                if (jqXHR.status === 304) {
                                    ShowToastError("The order priority not update!");
                                }
                                else {
                                    ShowToastError("Fail to update the order priority!");
                                }
                            }
                            DismissPopupModal();
                        })
                        .fail((xhr, status, error) => {
                            let errorData = xhr.responseJSON;
                            ShowToastError(`<b>${errorData.message}</b>!`, "Error", 10000);
                        });
                }
            });
        }
    }

</script>