@model lissystem.Models.Form.Planner.OrderScheduler.OrderStatusRequest

<div id="modalDetail" class="modal-content">
    <div class="modal-header flex-column align-items-start py-2">
        <h5 id="modalTitle" class="modal-title"><i class="bi bi-toggles me-2"></i>Order Route Status update form</h5>
    </div>
    <div class="modal-body px-2 py-0">
        <form id="frmGlobalAction" class="row g-3 mt-2 mb-2">
            <div class="col-auto">
                <label for="selectSetAllStatus" class="form-label">Status</label>
            </div>
            <div class="col-auto">
                <select id="selectSetAllStatus" class="form-select form-select-sm">
                    @foreach (var item in Model.statusSelectListItem)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-sm btn-warning" onclick="SetValueToAll()">Set All</button>
            </div>
        </form>
        <hr />
        <form id="frmOrderStatus" action="" method="post">
            @Html.AntiForgeryToken()
            <table class="table align-middle table-striped">
                <thead>
                    <tr>
                        <th>Order no.</th>
                        <th>Line no.</th>
                        <th>Split no.</th>
                        <th>QTY Request</th>
                        <th>QTY ToGo</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.data.Count(); i++)
                    {
                        <tr>
                            @Html.HiddenFor(p => p.data[i].order_no)
                            @Html.HiddenFor(p => p.data[i].line_no)
                            @Html.HiddenFor(p => p.data[i].split_no)
                            <td>@Model.data[i].order_no</td>
                            <td>@Model.data[i].line_no</td>
                            <td>@Model.data[i].split_no</td>
                            <td>@string.Format("{0:n0}", Model.data[i].qty_reqd)</td>
                            <td>@string.Format("{0:n0}", Model.data[i].qty_togo)</td>
                            <td>
                                <select id="selectStatus" name="data[@i].status" class="form-select form-select-sm" required>
                                    @foreach (var item in Model.statusSelectListItem)
                                    {
                                        bool isSelected = item.Value == Model.data[i].status;
                                        <option value="@item.Value" @(isSelected ? "selected" : "")>@item.Text</option>
                                    }
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    </div>
    <div class="modal-footer px-2 py-1">
        <button type="button" class="btn btn-sm btn-success me-2" onclick="SubmitRequest()"><i class="bi bi-save me-1"></i>Update Status</button>
        <button type="button" class="btn btn-sm btn-secondary" onclick="DismissPopupModal()">Cancel</button>
    </div>
</div>

<script>
    var frmActionValidate = $('#frmGlobalAction').validate();
    var frmValidate = $('#frmOrderStatus').validate();

    function SetValueToAll() {
        if (frmActionValidate.valid()) {
            let statusVal = $('select#selectSetAllStatus').val();
            if (!IsNullOrEmpty(statusVal)) {
                $('select#selectStatus').val(statusVal).change();
            }
        }
    }

    function SubmitRequest() {
        if (frmValidate.valid()) {
            ConfirmDialog("Are you sure?", "Confirm to update the Order status", "warning").then((res) => {
                if (res) {
                    let formData = $('#frmOrderStatus').serialize();
                    $.post('@Url.Action("RequestOrderStatusUpdate")', formData)
                        .done((data, status, jqXHR) => {
                            if (jqXHR.status === 200) {
                                TableReload();
                                ShowToastSuccess("The Order status been updated.");
                            }
                            else {
                                if (jqXHR.status === 304) {
                                    ShowToastError("The order status not update!");
                                }
                                else {
                                    ShowToastError("Fail to update the order status!");
                                }
                            }
                            DismissPopupModal();
                        })
                        .fail((xhr, status, error) => {
                            let errorData = xhr.responseJSON;
                            ShowToastError(`<b>${errorData.message}</b>!`, "Error", 10000);
                            DismissPopupModal();
                        });
                }
            });
        }
    }

</script>