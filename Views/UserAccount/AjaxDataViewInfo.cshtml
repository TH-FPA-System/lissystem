@model lissystem.Models.Form.FormSystemAccountView
@{ 
    bool isCurrentAccountID = Model.UserAccount.account_id.Equals(LISRequest.CurrentAccountId);
}

<div id="modalDetail" class="modal-content">
    <div class="modal-header flex-column align-items-start">
        <h5 id="modalTitle" class="modal-title"><i class="bi bi-person-circle me-1"></i>@Model.UserAccount.Information.display_name</h5>
    </div>
    <div class="modal-body px-1">
        <ul class="nav nav-tabs" id="tabView" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="userAccount-tab" data-bs-toggle="tab" data-bs-target="#userAccount" role="tab" aria-controls="userAccount" aria-selected="true"><i class="bi bi-person-check me-2"></i>Account</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="security-tab" data-bs-toggle="tab" data-bs-target="#security" role="tab" aria-controls="security" aria-selected="true"><i class="bi bi-key-fill me-2"></i>Security</button>
            </li>
        </ul>
        <div class="tab-content" id="tabViewContent">
            <!-- User account pane -->
            <div class="tab-pane fade show active px-1 py-2" id="userAccount" role="tabpanel" aria-labelledby="userAccount-tab">
                <form id="frmUserAccountEditor" method="post">
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(p => p.UserAccount.account_id)
                    <div class="mb-2">
                        <label class="form-label">Account name</label>
                        <input type="text" class="form-control" value="@Model.UserAccount.account_name" readonly />
                    </div>
                    <div class="mb-2">
                        @Html.LabelFor(p => p.UserAccount.Information.code, "Code", new { @class = "form-label" })
                        @Html.TextBoxFor(p => p.UserAccount.Information.code, new { @class = "form-control", @required = "required", @maxlength = "12" })
                    </div>
                    <div class="mb-2">
                        @Html.LabelFor(p => p.UserAccount.Information.display_name, "Display name", new { @class = "form-label" })
                        @Html.TextBoxFor(p => p.UserAccount.Information.display_name, new { @class = "form-control", @required = "required", @maxlength = "64" })
                    </div>
                    <div class="mb-2">
                        @Html.LabelFor(p => p.UserAccount.Information.role_id, "User Role/Group", new { @class = "form-label", @required = "required" })
                        @Html.DropDownListFor(p => p.UserAccount.Information.role_id, Model.RoleSelectListItem, !isCurrentAccountID ? new { @class = "form-select" } : new { @class = "form-select", @disabled = true })
                    </div>
                    <div class="mb-2">
                        <div class="form-check form-check-inline">
                            @Html.CheckBoxFor(p => p.UserAccount.Information.disabled, !isCurrentAccountID ? new { @class = "form-check-input" } : new { @class = "form-check-input", @disabled = true })
                            @Html.LabelFor(p => p.UserAccount.Information.disabled, "Disabled", new { @class = "form-check-label" })
                        </div>
                        <div class="form-check form-check-inline">
                            @Html.CheckBoxFor(p => p.UserAccount.Information.canlogin, !isCurrentAccountID ? new { @class = "form-check-input" } : new { @class = "form-check-input", @disabled = true })
                            @Html.LabelFor(p => p.UserAccount.Information.canlogin, "Can Login", new { @class = "form-check-label" })
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-floppy2 me-1"></i>Update</button>
                    </div>
                </form>
            </div>
            <!-- User security pane -->
            <div class="tab-pane fade px-1 py-2" id="security" role="tabpanel" aria-labelledby="security-tab">
                <form id="frmUserAccountSecurityEditor" method="post">
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(p => p.UserAccount.account_id)
                    <div class="mb-2">
                        @Html.LabelFor(p => p.UserAccountSecurity.password, "Password", new { @class = "form-label" })
                        @Html.PasswordFor(p => p.UserAccountSecurity.password, new { @class = "form-control", @required = "required", @maxlength = "24" })
                    </div>
                    <div class="mb-2">
                        @Html.LabelFor(p => p.UserAccountSecurity.confirmPassword, "Confirm password", new { @class = "form-label" })
                        @Html.PasswordFor(p => p.UserAccountSecurity.confirmPassword, new { @class = "form-control", @required = "required", @maxlength = "24" })
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-floppy2 me-1"></i>Update</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="DismissPopupModal()">Close</button>
    </div>
</div>

<script>
    $(document).ready(function () {
        /*
        * Form validation
        * https://jqueryvalidation.org/documentation/
        */

        // Account data update
        $('#frmUserAccountEditor').validate({
            errorClass: "invalid-feedback",
            rules: {
                'UserAccount.Information.code': {
                    required: true
                },
                'UserAccount.Information.display_name': {
                    required: true
                },
                'UserAccount.Information.role_id': {
                    required: true
                }
            },
            messages: {
                'UserAccount.Information.code': {
                    required: 'Required account code!',
                },
                'UserAccount.Information.display_name': {
                    required: 'Required account display name!'
                },
                'UserAccount.Information.role_id': {
                    required: 'Required account role group!'
                }
            },
            submitHandler: function (frm) {
                let formData = $(frm).serialize();
                $.post('@Url.Action("AjaxDataAccount_Update")', formData)
                    .done((data, status, jqXHR) => {
                        if ([200, 304].includes(jqXHR.status)) {
                            TableReload();
                            ShowToastSuccess("Account data update successful"); 
                        }
                        else {
                            ShowToastError("Account data has not been updated");
                        }
                    })
                    .fail((xhr, status, error) => {
                        let errData = xhr.responseJSON;
                        ShowToastError(`Error update account data ${errData.message}!`);
                    });
            }
        });

        // Account security update
        $('#frmUserAccountSecurityEditor').validate({
            errorClass: "invalid-feedback",
            rules: {
                'UserAccountSecurity.password': {
                    required: true
                },
                'UserAccountSecurity.confirmPassword': {
                    required: true,
                    equalTo: '#UserAccountSecurity_password'
                }
            },
            messages: {
                'UserAccountSecurity.password': {
                    required: 'Required account password!'
                },
                'UserAccountSecurity.confirmPassword': {
                    required: 'Required account confirm password!',
                    equalTo: 'Password and confirm password do not match!'
                }
            },
            submitHandler: function (frm) {
                let formData = $(frm).serialize();
                $.post('@Url.Action("AjaxDataAccountSecurity_Update")', formData)
                    .done((data, status, jqXHR) => {
                        if ([200, 304].includes(jqXHR.status)) {
                            ShowToastSuccess("Account password update successful"); 
                            $('#frmUserAccountSecurityEditor').trigger('reset');
                        }
                        else {
                            ShowToastError("Account password has not been updated");
                        }
                    })
                    .fail((xhr, status, error) => {
                        let errData = xhr.responseJSON;
                        ShowToastError(`Error update account password ${errData.message}!`);
                    });
            }
        });

    });
</script>