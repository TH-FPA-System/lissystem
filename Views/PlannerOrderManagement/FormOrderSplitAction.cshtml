@model lissystem.Models.Form.Planner.OrderScheduler.OrderSplitFormRequest

<div id="modalDetail" class="modal-content">
    <div class="modal-header flex-column align-items-start py-2">
        <h5 id="modalTitle" class="modal-title"><i class="bi bi-box-arrow-up-right me-2"></i>Split order form</h5>
    </div>
    <div class="modal-body px-2 py-0">
        <form id="frmGlobalAction" class="row g-3 mt-2 mb-2">
            <div class="col-auto">
                <label for="numSetAllSplitQTY" class="form-label">Split QTY</label>
            </div>
            <div class="col-auto">
                <input type="number" id="numSetAllSplitQTY" required value="1" min="1" max="99" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-sm btn-warning" onclick="SetSplitQTYValueToAll()">Set All</button>
                <button type="button" class="btn btn-sm btn-light" onclick="ResetToAll()">Reset to All</button>
            </div>
        </form>
        <hr />
        <form id="frmOrderSplit" method="post" class="mt-2">
            @Html.AntiForgeryToken()
            <table class="table align-middle table-striped">
                <thead>
                    <tr>
                        <th>Order no.</th>
                        <th>Line no.</th>
                        <th>Split no.</th>
                        <th>QTY Request</th>
                        <th>QTY ToGo</th>
                        <th>Split QTY / Batch</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.data.Count(); i++)
                    {
                        <tr>
                            @Html.HiddenFor(p => p.data[i].order_no)
                            @Html.HiddenFor(p => p.data[i].line_no)
                            @Html.HiddenFor(p => p.data[i].split_no)
                            <td>@Model.data[i].order_no</td>
                            <td>@Model.data[i].line_no</td>
                            <td>@Model.data[i].split_no</td>
                            <td>@string.Format("{0:n0}", Model.data[i].qty_reqd)</td>
                            <td>@string.Format("{0:n0}", Model.data[i].qty_togo)</td>
                            <td>
                                @Html.TextBoxFor(p => p.data[i].split_batch_count, new { @id = "numSplitQTY", @type = "number", @class = "form-control form-control-sm", @required = true, @min = 1, @max = (Model.data[i].qty_togo == 1 ? 1 : Model.data[i].qty_togo - 1) })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    </div>
    <div class="modal-footer px-2 py-1">
        <button type="button" class="btn btn-sm btn-success me-2" onclick="SubmitRequest()" @(Model.data.Count() == 0 ? "disabled" : "")><i class="bi bi-save me-1"></i>Split the order</button>
        <button type="button" class="btn btn-sm btn-secondary" onclick="DismissPopupModal()">Cancel</button>
    </div>
</div>

<script>
    var frmActionValidate = $('#frmGlobalAction').validate();
    var frmValidate = $('#frmOrderSplit').validate();

    function SetSplitQTYValueToAll() {
        if (frmActionValidate.valid()) {
            let QTYVal = $('input[type=number]#numSetAllSplitQTY').val();
            if (!IsNullOrEmpty(QTYVal)) {
                $('#frmOrderSplit input[type=number]#numSplitQTY').val(QTYVal);
            }
            frmValidate.form();
        }
    }

    function ResetToAll() {
        $('#frmOrderSplit').trigger('reset');
        frmValidate.form();
    }

    function SubmitRequest() {
        let totalOrders = @Model.data.Count();
        if (totalOrders > 0 && frmValidate.valid()) {
            ConfirmDialog("Are you sure?", "Confirm to split the Order", "warning").then((res) => {
                if (res) {
                    //$('#frmOrderSplit').trigger('submit');
                    let formData = $('#frmOrderSplit').serialize();
                    $.post('@Url.Action("RequestSplitOrder")', formData)
                        .done((data, status, jqXHR) => {
                            if (jqXHR.status === 200) {
                                TableReload();
                                ShowToastSuccess("The Order split has been updated.");
                            }
                            else {
                                if (jqXHR.status === 304) {
                                    ShowToastError("The order split not update!");
                                }
                                else {
                                    ShowToastError("Fail to update the order split!");
                                }
                            }
                            DismissPopupModal();
                        })
                        .fail((xhr, status, error) => {
                            let errorData = xhr.responseJSON;
                            ShowToastError(`<b>${errorData.message}</b>!`, "Error", 10000);
                        });
                }
            });
        }
    }

</script>