@model lissystem.Models.Form.Planner.OrderScheduler.OrderToGoAdjustmentRequest

<div id="modalDetail" class="modal-content">
    <div class="modal-header flex-column align-items-start py-2">
        <h5 id="modalTitle" class="modal-title"><i class="bi bi-plus-slash-minus me-2"></i>Order ToGo adjustment form</h5>
    </div>
    <div class="modal-body px-2 py-0">
        <form id="frmGlobalAction" class="row g-3 mt-2 mb-2">
            <div class="col-auto">
                <label for="numSetAllToGo" class="form-label">QTY Togo</label>
            </div>
            <div class="col-auto">
                <input type="number" id="numSetAllToGo" required value="1" min="0" max="999" class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-sm btn-warning" onclick="SetToGoValueToAll()">Set All</button>
                <button type="button" class="btn btn-sm btn-light" onclick="ResetToAll()">Reset to All</button>
            </div>
        </form>
        <hr />
        <form id="frmOrderToGoAdjustment" method="post" class="mt-2">
            @Html.AntiForgeryToken()
            <table class="table align-middle table-striped">
                <thead>
                    <tr>
                        <th>Order no.</th>
                        <th>Line no.</th>
                        <th>Split no.</th>
                        <th>QTY Request</th>
                        <th>QTY In-Progress</th>
                        <th>QTY ToGo</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.data.Count(); i++)
                    {
                        <tr>
                            @Html.HiddenFor(p => p.data[i].order_no)
                            @Html.HiddenFor(p => p.data[i].line_no)
                            @Html.HiddenFor(p => p.data[i].split_no)
                            <td>@Model.data[i].order_no</td>
                            <td>@Model.data[i].line_no</td>
                            <td>@Model.data[i].split_no</td>
                            <td>@string.Format("{0:n0}", Model.data[i].qty_reqd)</td>
                            <td>@string.Format("{0:n0}", Model.data[i].qty_inprogress)</td>
                            <td>
                                @Html.LISTextBoxFor(p => p.data[i].qty_togo, new { @id = "numToGo", @type = "number", @class = "form-control form-control-sm", @required = true, @min = 0, @max = Model.data[i].qty_reqd })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </form>
    </div>
    <div class="modal-footer px-2 py-1">
        <button type="button" class="btn btn-sm btn-success me-2" onclick="SubmitRequest()"><i class="bi bi-save me-1"></i>Adjust ToGo</button>
        <button type="button" class="btn btn-sm btn-secondary" onclick="DismissPopupModal()">Cancel</button>
    </div>
</div>

<script>
    var frmActionValidate = $('#frmGlobalAction').validate();
    var frmValidate = $('#frmOrderToGoAdjustment').validate();

    function SetToGoValueToAll() {
        if (frmActionValidate.valid()) {
            let ToGoVal = $('input[type=number]#numSetAllToGo').val();
            if (!IsNullOrEmpty(ToGoVal)) {
                $('#frmOrderToGoAdjustment input[type=number]#numToGo').val(ToGoVal);
            }
        }
        frmValidate.form();
    }

    function ResetToAll() {
        $('#frmOrderToGoAdjustment').trigger('reset');
        frmValidate.form();
    }

    function SubmitRequest() {
        if (frmValidate.valid()) {
            ConfirmDialog("Are you sure?", "Confirm adjustment to the Order To Go quantity", "warning").then((res) => {
                if (res) {
                    let formData = $('#frmOrderToGoAdjustment').serialize();
                    $.post('@Url.Action("RequestOrderToGoAdjustment")', formData)
                        .done((data, status, jqXHR) => {
                            if (jqXHR.status === 200) {
                                TableReload();
                                ShowToastSuccess("The Order To Go has been updated.");
                            }
                            else {
                                if (jqXHR.status === 304) {
                                    ShowToastError("The order To Go not update!");
                                }
                                else {
                                    ShowToastError("Fail to update the order To Go!");
                                }
                            }
                            DismissPopupModal();
                        })
                        .fail((xhr, status, error) => {
                            let errorData = xhr.responseJSON;
                            ShowToastError(`<b>${errorData.message}</b>!`, "Error", 10000);
                        });
                }
            });
        }
    }

</script>