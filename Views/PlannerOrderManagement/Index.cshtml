@model lissystem.Models.Form.Planner.OrderScheduler.OrderSchForm
@{
    ViewBag.Title = "Planner (Order management)";
}

<div class="app-content-header">
    <div class="container-fluid border-bottom pb-2">
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0"><i class="bi bi-receipt me-2"></i>Order scheduler management</h3></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item">Planner modules</li>
                    <li class="breadcrumb-item active" aria-current="page">Order scheduler management</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <!--begin:Data filter-->
        <div class="card card-black shadow-none mb-3">
            <div class="card-header py-2">
                <p class="card-title"><i class="bi bi-funnel me-2"></i>Data filter</p>
                <div class="card-tools">
                    @*<button class="btn btn-tool"><i class="bi bi-arrow-clockwise me-1"></i>Refresh</button>*@
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-md-2 mb-2">
                        <label class="form-label" for="filterOrderNo">Order no.</label>
                        <input type="number" id="filterOrderNo" class="form-control form-control-sm" value="@Model.filterOrderNo" min="@int.MinValue" max="@int.MaxValue" />
                    </div>
                    <div class="col-md-2 mb-2">
                        <label class="form-label" for="filterProductClass">Product @Model.filterProductClass</label>
                        <select id="filterProductClass" class="form-select form-select-sm">
                            <option value="">All products</option>
                            @foreach (var item in Model.ProductClasses)
                            {
                                bool isSelected = Model.filterProductClass == item.Value;
                                <option value="@item.Value" @(isSelected ? "selected" : "")>@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 mb-2">
                        <label class="form-label" for="filterToolClass">Tool class</label>
                        <select id="filterToolClass" class="form-select form-select-sm">
                            <option value="">All tool class</option>
                            @foreach (var item in Model.ToolClasses)
                            {
                                bool isSelected = Model.filterToolClass == item.Value;
                                <option value="@item.Value" @(isSelected ? "selected" : "")>@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="form-label" for="filterShipTo">Ship To</label>
                        <select id="filterShipTo" class="form-select form-select-sm">
                            <option value="@int.MinValue">All</option>
                            @foreach (var item in Model.ShipToCustomers)
                            {
                                bool isSelected = Model.filterShipTo == item.Value;
                                <option value="@item.Value" @(isSelected ? "selected" : "")>@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 mb-2">
                        <label class="form-label" for="filterStatus">Status</label>
                        <select id="filterStatus" class="form-select form-select-sm">
                            <option value="">All</option>
                            @foreach (var item in Model.OrderStatus)
                            {
                                bool isSelected = Model.filterStatus == item.Value;
                                <option value="@item.Value" @(isSelected ? "selected" : "")>@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 mb-2">
                        <label class="form-label" for="filterDateRange">Request Date</label>
                        <div id="filterDateRange" class="border rounded d-flex date-rangepicker-box">
                            <i class="bi bi-calendar-week me-2"></i>
                            <span class="flex-grow-1">Genarating date range picker...</span>
                            <i class="bi bi-chevron-down"></i>
                        </div>
                    </div>
                    <div class="col-md-2 mb-2 align-self-end">
                        <div class="form-check pt-4">
                            <input type="checkbox" id="filterOnlyNotCompleted" class="form-check-input" @(Model.filterOnlyNotCompleted ? "checked" : "") />
                            <label class="form-check-label" for="filterOnlyNotCompleted">Only not-completed</label>
                        </div>
                    </div>
                </div>
                <div>
                    <button class="btn btn-sm btn-secondary" onclick="TableReload()"><i class="bi bi-search me-1"></i>Search</button>
                </div>
            </div>
        </div>
        <!--end:Data filter-->
        <!--begin:Data table-->
        <div class="card card-black shadow-none">
            <div class="card-header py-2">
                <p class="card-title"><i class="bi bi-table me-2"></i>Data view</p>
            </div>
            <div class="card-body pt-0">
                <!--begin:Datatable colums toggle-->
                <div class="toggleColumns pt-2">
                    <h5>Columns visibility</h5>
                </div>
                <!--end:Datatable colums toggle-->
                <hr class="mb-0" />
                <table id="tblDataView" class="table table-striped table-hover table-responsive dt-nowrap">
                    <thead>
                        <tr>
                            <th width="30">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" value="" id="selectRow" />
                                    <label class="form-check-label" for="selectRow"></label>
                                </div>
                            </th>
                            <th width="100"><i class="bi bi-receipt me-1"></i>Order no.</th>
                            <th width="100">Line no.</th>
                            <th width="100">Split no.</th>
                            <th width="100">Ship to</th>
                            <th width="50">Dest</th>
                            <th width="100">Shipment</th>
                            <th width="100">Part</th>
                            <th>Description</th>
                            <th width="100"><i class="bi bi-calendar-check me-1"></i>Date</th>
                            <th width="100">Qty reqd</th>
                            <th width="100">Progress</th>
                            <th width="100">Routed</th>
                            <th width="80">To Go</th>
                            <th width="100">Priority</th>
                            <th width="80"><i class="bi bi-toggles me-1"></i>Status</th>
                            <th width="80">Allocate</th>
                            <th width="100">Serial</th>
                            <th width="100">Ship Mode</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
                <hr />
                <!--begin:Action box-->
                @if (LISGlobal.CurrentModuleRole.canwrite)
                {
                    <div id="action-box" class="d-flex justify-content-center">
                        <button class="btn btn-sm btn-light mx-1" onclick="ActionSplitOrders()"><i class="bi bi-box-arrow-up-right me-1"></i>Split orders</button>
                        <button class="btn btn-sm btn-light mx-1" onclick="ActionOrdersToGoAdjustment()"><i class="bi bi-plus-slash-minus me-1"></i>Adjust ToGo</button>
                        <button class="btn btn-sm btn-primary mx-1" onclick="ActionOrdersPriority()"><i class="bi bi-sort-numeric-up-alt me-1"></i>Set Priority</button>
                        <button class="btn btn-sm btn-warning mx-1" onclick="ActionOrdersStatus()"><i class="bi bi-toggles me-1"></i>Set Status</button>
                        <button class="btn btn-sm btn-danger mx-1" onclick="ActionCancelOrder()"><i class="bi bi-x-circle me-1"></i>Cancel Order</button>
                    </div>
                }

                <!--end:Action box-->
            </div>
        </div>
        <!--end:Data table-->
    </div>
</div>

<!-- View data modal -->
<div id="viewPopupWindow" class="modal fade" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
    </div>
</div>

@section scripts {
    <script>
        var filterDateRange;
        var viewPopupQuery = '#viewPopupWindow';

        /* Datatable */
        var tblDataView;
        // Define datatable options.
        var dataTblOptions = {
            ajax: {
                url: "@Url.Action("AjaxDataList")",
                type: "get",
                data: function (d) {
                    let filterOrderNo = $('#filterOrderNo').val();
                    let filterShipTo = $('#filterShipTo').val();
                    if (IsNullOrEmpty(filterOrderNo))
                        filterOrderNo = @int.MinValue;
                    if (IsNullOrEmpty(filterShipTo))
                        filterShipTo = @int.MinValue;

                    let rangeDateFilter = filterDateRange.data('daterangepicker');

                    d.orderno = filterOrderNo;
                    d.partclass = $('select#filterProductClass').val();
                    d.toolclass = $('select#filterToolClass').val();
                    d.shipto = filterShipTo;
                    d.status = $('select#filterStatus').val();
                    d.only_notcompleted = $(`input[type=checkbox]#filterOnlyNotCompleted`).prop('checked');
                    d.begindate = moment(rangeDateFilter.startDate).format();
                    d.enddate = moment(rangeDateFilter.endDate).format();

                    return d;
                },
                error: function (jqXHR, statusStr, error) {
                    let tblBody = $(tblDataView.table().node()).find('tbody .dt-empty');
                    if (jqXHR.status === 401) {
                        tblBody.html(`<span class="text-danger">Your permission unauthorized!</span>`);
                    } else {
                        tblBody.html(`<span class="text-danger">${error}</span>`);
                    }
                }
            },
            fixedColumns: { start: 1 },
            scrollX: true,
            columns: [
                {
                    data: null,
                    className: 'dt-left border-end',
                    defaultContent: '<input type="checkbox" name="chkRowSelect" onclick="SelectRow(this)" class="form-check-input">',
                    orderable: false,
                    searchable: false
                },
                {
                    data: 'order_no', type: 'num', render: function (data, type, row) {
                        if (type === 'display') {
                            return `<i class="bi bi-receipt me-1"></i>${data}`
                        }
                        return data;
                    },
                    searchBuilderType: 'string'
                },
                { data: 'line_no', type: 'num' },
                { data: 'split_no', type: 'num' },
                { data: 'ship_to', type: 'num' },
                { data: 'destination_code' },
                { data: 'shipment_no', type: 'num' },
                { data: 'part', searchBuilderType: 'string' },
                { data: 'description' },
                {
                    data: 'date_reqd', type: 'moment-DD/MM/YYYY', render: function (data, type, row) {
                        if (type === 'display' || type === 'filter') {
                            return moment(data).format('DD/MM/YYYY');
                        }
                        return data;
                    }
                },
                { data: 'qty_reqd', type: 'num', className: 'dt-center' },
                { data: 'qty_in_progress', type: 'num', className: 'dt-center', visible: false },
                { data: 'qty_routed', type: 'num', className: 'dt-center', visible: false },
                { data: 'sch_qty_togo', type: 'num', className: 'dt-center' },
                {
                    data: 'sch_priority', type: 'num', className: 'dt-center', render: function (data) {
                        return `<span class="badge text-bg-primary">${data}</span>`;
                    }
                },
                {
                    data: 'sch_status', render: function (data) {
                        if (data === 'A')
                            return `<span class="badge text-bg-success">Activate</span>`;
                        else
                            return `<span class="badge text-bg-secondary">Hold</span>`;
                    }
                },
                {
                    data: 'serial_allocated', visible: false, render: function (data) {
                        if (data === 'Y')
                            return `<span class="badge text-bg-success">Yes</span>`;
                        else
                            return `<span class="badge text-bg-secondary">No</span>`;
                    } },
                {
                    data: 'serial', visible: true, render: function (data) {
                        if (IsNullOrEmpty(data))
                            return `<span class="badge text-bg-secondary">N</span>`;
                        else { 
                            if (data === 'CANCELED')
                                return `<span class="badge text-bg-danger">${data}</span>`; 
                            else
                                return `<span class="badge text-bg-success">${data}</span>`;
                        }
                    }
                },
                {
                    data: 'ship_mode', type: 'string', visible: true, render: function (data) {
                        if (IsNullOrEmpty(data))
                            return data;
                        else
                            return `<span class="badge text-bg-info"><i class="bi bi-airplane-fill me-1"></i>${data}</span>`;
                    } }
            ],
            columnDefs: [
                { className: 'dt-nowrap dt-left', targets: '_all' }
            ],
            order: [[14, 'desc'], [9, 'asc'], [3, 'asc']],
            select: { style: 'multi' },
            language: {
                info: '<i class="bi bi-info-lg me-1"></i>Showing Order on page _PAGE_ of _PAGES_ (Total _TOTAL_ orders)',
                infoEmpty: 'No order data available'
            },
            initComplete: function (settings, json) {
                let columns = this.api().columns();
                let dynamicToggleColDiv = $('.toggleColumns');

                if (dynamicToggleColDiv) {
                    columns.every((i) => {
                        if (i > 3) {
                            let col = this.api().column(i);
                            let header = col.header();
                            if (!IsNullOrEmpty(header.textContent)) {
                                dynamicToggleColDiv.append(`<div class="form-check-inline">
                                    <input type="checkbox" class="form-check-input col-toggle" id="colToggle${i}" data-column="${i}" />
                                    <label class="form-check-label" for="colToggle${i}">${header.textContent}</label>
                                </div>`);
                            }
                        }
                    });
                }

                columns.every((i) => {
                    let col = this.api().column(i);
                    let chkToggleCol = $(`input[type=checkbox].col-toggle[data-column=${i}]`);
                    if (chkToggleCol.length > 0) {
                        chkToggleCol.prop('checked', col.visible());
                    }
                });

                document.querySelectorAll('input[type=checkbox].col-toggle').forEach(function(elm) {
                    elm.addEventListener('click', function (e) {
                        if (tblDataView) {
                            let checked = e.target.checked;
                            let colIndex = e.target.getAttribute('data-column');
                            let column = tblDataView.column(colIndex);
                            if (colIndex && column) {
                                column.visible(checked);
                            }
                            tblDataView.columns.adjust().draw();
                            //tblDataView.draw();
                        }
                    });
                });

            }
        };

        $(document).ready(function () {

            $("select[id^='filter']").each(function(i, e) {
                $(e).select2({
                    //containerCssClass: "select2--small",
                    dropdownCssClass: "select2--small"
                });
            });

            // DataRange https://www.daterangepicker.com/#examples
            let filterDateRangeStart = moment().startOf('year');
            let filterDateRangeEnd = moment().endOf('year');
            function daterangePicked(start, end) {
                $('#filterDateRange span').html(`${start.format('DD/MM/YYYY')} - ${end.format('DD/MM/YYYY')}`);
            }

            filterDateRange = $("#filterDateRange").daterangepicker({
                opens: "left",
                minYear: 2000,
                maxYear: parseInt(moment().format("YYYY"), 5),
                locale: {
                    format: "DD/MM/YYYY",
                    separator: " - ",
                },
                startDate: filterDateRangeStart,
                endDate: filterDateRangeEnd,
                ranges: {
                    'Today': [moment(), moment()],
                    'This Month': [moment().startOf('month'), moment().endOf('month')],
                    'This Year': [moment().startOf('year'), moment().endOf('year')],
                    'Cover All': [moment('2000-01-01').startOf('year'), moment('2099-12-31').endOf('year')]
                }
            }, function (start, end, label) {
                daterangePicked(start, end);
            });
            daterangePicked(filterDateRangeStart, filterDateRangeEnd);

            EnabledActionBoxButtons(false);

            /* Datatable */
            // Render datatable.
            $('#tblDataView').on('xhr.dt', function (e, settings, json, xhr) {
                ClearRowSelected();
            });

            tblDataView = $('#tblDataView').DataTable(dataTblOptions);

            tblDataView.on('select', function (e, dt, type, indexes) {
                if (type === 'row') {
                    let checkbox = tblDataView.rows(indexes).nodes().to$().find('input[type=checkbox][name=chkRowSelect]');
                    checkbox.prop('checked', true);
                    SelectRow(checkbox);
                }
            });
            tblDataView.on('deselect', function (e, dt, type, indexes) {
                if (type === 'row') {
                    let checkbox = tblDataView.rows(indexes).nodes().to$().find('input[type=checkbox][name=chkRowSelect]');
                    checkbox.prop('checked', false);
                    SelectRow(checkbox);
                }
            });

            // Reload datatable (AJAX).
            window.TableReload = function () {
                if (tblDataView) {
                    tblDataView.ajax.reload();
                }
            }

            // Datatable header all select checkbox (Click event).
            $('input[type=checkbox]#selectRow').on("click", function (e) {
                let checked = e.target.checked;
                /*tblDataView.cells(null, 0).every(function () {
                    let cell = this.node();
                    $(cell).find('input[type=checkbox][name=chkRowSelect]').prop('checked', checked);
                });*/
                let rowApplied = tblDataView.rows({ search: 'applied' });
                if (checked) {
                    rowApplied.select();
                } else {
                    tblDataView.rows().deselect();
                }
                rowApplied.nodes().each(function (r) {
                    $(r).find('input[type=checkbox][name=chkRowSelect]').prop('checked', checked);
                });
                EnabledActionBoxButtons(checked);
            });

            /* Popup modal view account info */
            $(viewPopupQuery).on('hidden.bs.modal', function (e) {
                $(this).find('.modal-dialog').removeClass('modal-xl modal-lg modal-fullscreen');
            });

            window.DismissPopupModal = function () {
                let modalElm = $(viewPopupQuery);
                let modal = bootstrap.Modal.getInstance(modalElm);
                if (modal) {
                    modal.hide();
                }
            }

        });

        // Datatable row select function.
        function SelectRow(e) {
            let checked = $(e).prop('checked');
            let selectAllChk = $('input[type=checkbox]#selectRow');
            let totalRows = tblDataView.rows({ search: 'applied' }).count();
            let totalSelectedRows = tblDataView.rows(function (i, d, n) {
                return $(n).find('input[type=checkbox][name=chkRowSelect]').prop('checked');
            }).count();
            if (selectAllChk && checked) {
                if (totalSelectedRows === totalRows) {
                    selectAllChk.prop('indeterminate', false);
                    selectAllChk.prop('checked', true);
                }
                else if (totalSelectedRows > 0) {
                    selectAllChk.prop('indeterminate', true);
                }
                EnabledActionBoxButtons();
            }
            else
            {
                if (totalSelectedRows === 0) {
                    selectAllChk.prop('indeterminate', false);
                    selectAllChk.prop('checked', false);
                    EnabledActionBoxButtons(false);
                } else {
                    selectAllChk.prop('indeterminate', true);
                    selectAllChk.prop('chekced', false);
                }
            }
        }

        // Clear all rows selected.
        function ClearRowSelected() {
            let selectAllChk = $('input[type=checkbox]#selectRow');

            if (selectAllChk) {
                selectAllChk.prop('checked', false);
                selectAllChk.prop('indeterminate', false);
            }
            EnabledActionBoxButtons(false);
        }

        // Enable / Disabled action buttons.
        function EnabledActionBoxButtons(enabled = true) {
            $('#action-box button').each(function (i, e) {
                $(e).prop('disabled', !enabled);
            });
        }

        function GetActionRequestData() {
            let request = {};
            let selected = tblDataView.rows(function (i, d, node) {
                return $(node).find('input[type=checkbox][name=chkRowSelect]').prop('checked');
            }).data().toArray();

            request.data = selected.map((d) => {
                return {
                    order_no: d.order_no,
                    line_no: d.line_no,
                    split_no: d.split_no
                };
            });
            return request;
        }

        @if (LISGlobal.CurrentModuleRole.canwrite) {<text >
            // Request form to split order.
            function ActionSplitOrders() {
                let request = GetActionRequestData();
                if (request.data.length == 0)
                    return;

                let modalElm = $(viewPopupQuery);
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("FormOrderSplitAction")",
                    data: request
                }).done((html) => {
                    if (modalElm) {
                        modalElm.find('.modal-dialog').addClass('modal-lg');
                        modalElm.find('.modal-dialog').html(html);

                        let modal = new bootstrap.Modal(modalElm, {
                            backdrop: 'static',
                            keyboard: false
                        });
                        modal.show();
                    }
                });
            }

            // Request form to adjust order ToGo.
            function ActionOrdersToGoAdjustment() {
                let request = GetActionRequestData();
                if (request.data.length == 0)
                    return;

                let modalElm = $(viewPopupQuery);
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("FormOrderToGoAdjustmentAction")",
                    data: request
                }).done((html) => {
                    if (modalElm) {
                        modalElm.find('.modal-dialog').addClass('modal-lg');
                        modalElm.find('.modal-dialog').html(html);

                        let modal = new bootstrap.Modal(modalElm, {
                            backdrop: 'static',
                            keyboard: false
                        });
                        modal.show();
                    }
                });
            }

            // Request form to set order priority.
            function ActionOrdersPriority() {
                let request = GetActionRequestData();
                if (request.data.length == 0)
                    return;

                let modalElm = $(viewPopupQuery);
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("FormOrderPriorityAction")",
                    data: request
                }).done((html) => {
                    if (modalElm) {
                        modalElm.find('.modal-dialog').addClass('modal-lg');
                        modalElm.find('.modal-dialog').html(html);

                        let modal = new bootstrap.Modal(modalElm, {
                            backdrop: 'static',
                            keyboard: false
                        });
                        modal.show();
                    }
                });
            }

            // Request form to set order status.
            function ActionOrdersStatus() {
                let request = GetActionRequestData();
                if (request.data.length == 0)
                    return;

                let modalElm = $(viewPopupQuery);
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("FormOrderStatusAction")",
                    data: request
                }).done((html) => {
                    if (modalElm) {
                        modalElm.find('.modal-dialog').addClass('modal-lg');
                        modalElm.find('.modal-dialog').html(html);

                        let modal = new bootstrap.Modal(modalElm, {
                            backdrop: 'static',
                            keyboard: false
                        });
                        modal.show();
                    }
                });
            }

            // Request form to cancel order.
            function ActionCancelOrder() {
                let request = GetActionRequestData();
                if (request.data.length == 0)
                    return;
                
                let modalElm = $(viewPopupQuery);
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("FormOrderCancelAction")",
                    data: request
                }).done((html) => {
                    if (modalElm) {
                        modalElm.find('.modal-dialog').addClass('modal-lg');
                        modalElm.find('.modal-dialog').html(html);
                
                        let modal = new bootstrap.Modal(modalElm, {
                            backdrop: 'static',
                            keyboard: false
                        });
                        modal.show();
                    }
                });
            }

        </text>}
    </script>
}